# Copy this file to .env and fill in your real values. .env is gitignored --
# never commit real credentials.
#
# DagsHub-hosted MLflow tracking server, used by improvements/base/run_base.py
# (and any future improvements/<owner>/ run script via improvements/mlflow_utils.py).
MLFLOW_TRACKING_URI=https://dagshub.com/Ke-vin-S/wavCSE.mlflow
MLFLOW_TRACKING_USERNAME=your-dagshub-username
MLFLOW_TRACKING_PASSWORD=your-dagshub-access-token
